rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function participantPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/participants/$(userId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function giftEventPath(roomId, giftId) {
      return /databases/$(database)/documents/rooms/$(roomId)/gifts/$(giftId);
    }

    function validGiftPrice(data) {
      return (
        data.giftId == 'rose' && data.points == 10
      ) || (
        data.giftId == 'star' && data.points == 50
      ) || (
        data.giftId == 'dragon' && data.points == 500
      );
    }

    function economyFieldsUntouched() {
      return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'coins',
            'giftSentPoints',
            'giftReceivedPoints',
            'giftLevelPoints',
            'giftLevel',
            'lastGiftRoomId',
            'lastGiftEventId'
          ]);
    }

    function validGiftSenderUpdate(userId) {
      return request.auth.uid == userId
          && request.resource.data.lastGiftRoomId is string
          && request.resource.data.lastGiftEventId is string
          && existsAfter(
            giftEventPath(
              request.resource.data.lastGiftRoomId,
              request.resource.data.lastGiftEventId
            )
          )
          && getAfter(
            giftEventPath(
              request.resource.data.lastGiftRoomId,
              request.resource.data.lastGiftEventId
            )
          ).data.senderId == request.auth.uid
          && validGiftPrice(
            getAfter(
              giftEventPath(
                request.resource.data.lastGiftRoomId,
                request.resource.data.lastGiftEventId
              )
            ).data
          )
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'coins',
                'giftSentPoints',
                'giftLevelPoints',
                'lastGiftRoomId',
                'lastGiftEventId',
                'updatedAt'
              ])
          && request.resource.data.coins
              == resource.data.get('coins', 0)
                  - getAfter(
                      giftEventPath(
                        request.resource.data.lastGiftRoomId,
                        request.resource.data.lastGiftEventId
                      )
                    ).data.points
          && request.resource.data.giftSentPoints
              == resource.data.get('giftSentPoints', 0)
                  + getAfter(
                      giftEventPath(
                        request.resource.data.lastGiftRoomId,
                        request.resource.data.lastGiftEventId
                      )
                    ).data.points
          && request.resource.data.giftLevelPoints
              == resource.data.get('giftLevelPoints', 0)
                  + getAfter(
                      giftEventPath(
                        request.resource.data.lastGiftRoomId,
                        request.resource.data.lastGiftEventId
                      )
                    ).data.points;
    }

    function validGiftRecipientUpdate(userId) {
      return request.resource.data.lastGiftRoomId is string
          && request.resource.data.lastGiftEventId is string
          && existsAfter(
            giftEventPath(
              request.resource.data.lastGiftRoomId,
              request.resource.data.lastGiftEventId
            )
          )
          && getAfter(
            giftEventPath(
              request.resource.data.lastGiftRoomId,
              request.resource.data.lastGiftEventId
            )
          ).data.senderId == request.auth.uid
          && getAfter(
            giftEventPath(
              request.resource.data.lastGiftRoomId,
              request.resource.data.lastGiftEventId
            )
          ).data.recipientId == userId
          && validGiftPrice(
            getAfter(
              giftEventPath(
                request.resource.data.lastGiftRoomId,
                request.resource.data.lastGiftEventId
              )
            ).data
          )
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'giftReceivedPoints',
                'giftLevelPoints',
                'lastGiftRoomId',
                'lastGiftEventId'
              ])
          && request.resource.data.giftReceivedPoints
              == resource.data.get('giftReceivedPoints', 0)
                  + getAfter(
                      giftEventPath(
                        request.resource.data.lastGiftRoomId,
                        request.resource.data.lastGiftEventId
                      )
                    ).data.points
          && request.resource.data.giftLevelPoints
              == resource.data.get('giftLevelPoints', 0)
                  + getAfter(
                      giftEventPath(
                        request.resource.data.lastGiftRoomId,
                        request.resource.data.lastGiftEventId
                      )
                    ).data.points;
    }

    function accessGrantPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/access_grants/$(userId);
    }

    function privateCodePath(code) {
      return /databases/$(database)/documents/private_room_codes/$(code);
    }

    function taskCompletionPath(roomId, taskId) {
      return /databases/$(database)/documents/rooms/$(roomId)/task_completions/$(taskId);
    }

    function roomRewardPath(roomId, rewardId) {
      return /databases/$(database)/documents/rooms/$(roomId)/rewards/$(rewardId);
    }

    function validRoomTask(data) {
      return (
        data.taskKey == 'daily_join' && data.points == 10
      ) || (
        data.taskKey == 'daily_speaking' && data.points == 20
      ) || (
        data.taskKey == 'weekly_participation' && data.points == 50
      );
    }

    function validTaskRoomProgress(roomId) {
      return request.resource.data.lastTaskCompletionId is string
          && existsAfter(
            taskCompletionPath(
              roomId,
              request.resource.data.lastTaskCompletionId
            )
          )
          && getAfter(
            taskCompletionPath(
              roomId,
              request.resource.data.lastTaskCompletionId
            )
          ).data.userId == request.auth.uid
          && validRoomTask(
            getAfter(
              taskCompletionPath(
                roomId,
                request.resource.data.lastTaskCompletionId
              )
            ).data
          )
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'roomXp',
                'roomLevel',
                'lastTaskCompletionId',
                'updatedAt'
              ])
          && request.resource.data.roomXp
              == resource.data.get('roomXp', 0)
                  + getAfter(
                      taskCompletionPath(
                        roomId,
                        request.resource.data.lastTaskCompletionId
                      )
                    ).data.points
          && (
            (
              request.resource.data.roomLevel
                  == resource.data.get('roomLevel', 1)
              && request.resource.data.roomXp
                  < resource.data.get('roomLevel', 1) * 100
            )
            ||
            (
              request.resource.data.roomLevel
                  == resource.data.get('roomLevel', 1) + 1
              && request.resource.data.roomXp
                  >= resource.data.get('roomLevel', 1) * 100
              && request.resource.data.roomXp
                  < (resource.data.get('roomLevel', 1) + 1) * 100
            )
          );
    }

    function isHost(roomId) {
      return signedIn()
          && exists(roomPath(roomId))
          && get(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function isHostAfter(roomId) {
      return signedIn()
          && getAfter(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function oldHostStillPresent(roomId) {
      return resource.data.hostId is string
          && exists(participantPath(roomId, resource.data.hostId));
    }

    function isRoomMember(roomId) {
      return signedIn()
          && exists(participantPath(roomId, request.auth.uid));
    }

    function isModerator(roomId) {
      return isRoomMember(roomId)
          && get(participantPath(roomId, request.auth.uid)).data.isModerator == true;
    }

    // -------------------------
    // USERS / PROFILES
    // -------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId;

      // Users manage their own normal profile fields, but economy fields are
      // protected. Coin/gift counters may only change through an atomic,
      // validated room-gift transaction.
      allow update: if signedIn()
          && (
            (
              request.auth.uid == userId
              && economyFieldsUntouched()
            )
            ||
            validGiftSenderUpdate(userId)
            ||
            validGiftRecipientUpdate(userId)
            ||
            (
              request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['followersCount', 'followingCount'])
              && request.resource.data.followersCount is int
              && request.resource.data.followingCount is int
              && request.resource.data.followersCount >= 0
              && request.resource.data.followingCount >= 0
            )
          );

      allow delete: if signedIn() && request.auth.uid == userId;

      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }

      match /followers/{followerUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == followerUserId;
      }

      match /profile_visitors/{viewerUserId} {
        allow read: if signedIn() && request.auth.uid == userId;

        // The visitor records only their own visit on the target profile.
        allow create, update: if signedIn()
            && request.auth.uid == viewerUserId;

        allow delete: if signedIn()
            && (
              request.auth.uid == userId
              || request.auth.uid == viewerUserId
            );
      }

      match /visited_profiles/{targetUserId} {
        allow read, create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }

      match /room_history/{roomId} {
        allow read, create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }

      match /room_usage/{dayKey} {
        allow read: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
            && request.auth.uid == userId
            && request.resource.data.get('usedSeconds', 0) >= 0
            && request.resource.data.get('adsWatched', 0) >= 0
            && request.resource.data.get('adsWatched', 0) <= 3
            && (
              (
                request.resource.data.get('adsWatched', 0) < 3
                && request.resource.data.get('adBonusSeconds', 0) == 0
              )
              ||
              (
                request.resource.data.get('adsWatched', 0) == 3
                && request.resource.data.get('adBonusSeconds', 0) == 10800
              )
            );

        allow update: if signedIn()
            && request.auth.uid == userId
            && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'usedSeconds',
                  'lastSessionWasHost',
                  'lastRoomLevel',
                  'adsWatched',
                  'adBonusSeconds',
                  'updatedAt'
                ])
            && (
              (
                request.resource.data.get('adsWatched', 0)
                    == resource.data.get('adsWatched', 0)
                && request.resource.data.get('adBonusSeconds', 0)
                    == resource.data.get('adBonusSeconds', 0)
                && request.resource.data.get('usedSeconds', 0)
                    >= resource.data.get('usedSeconds', 0)
              )
              ||
              (
                request.resource.data.get('usedSeconds', 0)
                    == resource.data.get('usedSeconds', 0)
                && request.resource.data.get('adsWatched', 0)
                    == resource.data.get('adsWatched', 0) + 1
                && request.resource.data.get('adsWatched', 0) <= 3
                && (
                  (
                    request.resource.data.get('adsWatched', 0) < 3
                    && request.resource.data.get('adBonusSeconds', 0) == 0
                  )
                  ||
                  (
                    request.resource.data.get('adsWatched', 0) == 3
                    && request.resource.data.get('adBonusSeconds', 0) == 10800
                  )
                )
              )
            );

        allow delete: if false;
      }

      match /room_rewards/{rewardId} {
        allow read: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
            && request.resource.data.userId == userId
            && request.resource.data.roomId is string
            && request.resource.data.level is int
            && request.resource.data.type is string
            && request.resource.data.sourceRewardId is string
            && exists(
              /databases/$(database)/documents/rooms/$(request.resource.data.roomId)/participants/$(userId)
            )
            && exists(
              roomRewardPath(
                request.resource.data.roomId,
                request.resource.data.sourceRewardId
              )
            )
            && get(
              roomRewardPath(
                request.resource.data.roomId,
                request.resource.data.sourceRewardId
              )
            ).data.level == request.resource.data.level
            && get(
              roomRewardPath(
                request.resource.data.roomId,
                request.resource.data.sourceRewardId
              )
            ).data.type == request.resource.data.type;

        allow update, delete: if signedIn()
            && request.auth.uid == userId;
      }
    }

    // -------------------------
    // USERNAME RESERVATIONS
    // -------------------------
    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    // -------------------------
    // ROOM PROMOTIONS
    // -------------------------
    match /room_promotions/{promoId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -------------------------
    // PRIVATE ROOM CODES
    // -------------------------
    match /private_room_codes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.roomId is string;

      allow update, delete: if signedIn()
          && resource.data.hostId == request.auth.uid;
    }

    // -------------------------
    // VOICE ROOMS
    // -------------------------
    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.channelId == roomId;

      // Normally only the host updates the room.
      // If the old host participant is gone, a new authenticated host may
      // recover that stale room document without changing the channel id.
      allow update: if signedIn()
          && request.resource.data.channelId == resource.data.channelId
          && (
            (
              request.auth.uid == resource.data.hostId
              && (
                request.resource.data.hostId == resource.data.hostId
                ||
                (
                  request.resource.data.hostId is string
                  && exists(
                    participantPath(
                      roomId,
                      request.resource.data.hostId
                    )
                  )
                  && get(
                    participantPath(
                      roomId,
                      request.resource.data.hostId
                    )
                  ).data.isModerator == true
                )
              )
            )
            ||
            (
              !oldHostStillPresent(roomId)
              && request.resource.data.hostId == request.auth.uid
            )
            ||
            (
              isRoomMember(roomId)
              && request.resource.data.hostId == resource.data.hostId
              && validTaskRoomProgress(roomId)
            )
          );

      allow delete: if isHost(roomId);

      match /access_grants/{userId} {
        allow read: if signedIn()
            && (request.auth.uid == userId || isHost(roomId));

        allow create: if signedIn()
            && request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.code is string
            && exists(privateCodePath(request.resource.data.code))
            && get(privateCodePath(request.resource.data.code)).data.roomId == roomId;

        allow update: if false;

        allow delete: if signedIn()
            && (request.auth.uid == userId || isHost(roomId));
      }

      match /messages/{messageId} {
        allow read: if signedIn()
            && exists(participantPath(roomId, request.auth.uid));

        allow create: if signedIn()
            && exists(participantPath(roomId, request.auth.uid))
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;

        allow update: if false;

        allow delete: if signedIn()
            && (
              resource.data.userId == request.auth.uid
              || isHost(roomId)
              || (
                exists(participantPath(roomId, request.auth.uid))
                && get(participantPath(roomId, request.auth.uid)).data.isModerator == true
              )
            );
      }

      match /board_items/{itemId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
            && request.resource.data.userId == request.auth.uid
            && (
              isHost(roomId)
              || get(roomPath(roomId)).data.boardWriteEnabled == true
            );
        allow update: if false;
        allow delete: if isHost(roomId)
            || (isRoomMember(roomId) && resource.data.userId == request.auth.uid);
      }

      match /quiz_answers/{userId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isRoomMember(roomId)
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid;
        allow delete: if isHost(roomId)
            || (isRoomMember(roomId) && userId == request.auth.uid);
      }

      match /gifts/{giftId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.recipientId != request.auth.uid
            && validGiftPrice(request.resource.data)
            && (
              request.resource.data.recipientId == 'teacher_ai'
              ||
              exists(
                participantPath(
                  roomId,
                  request.resource.data.recipientId
                )
              )
            )
            && getAfter(userPath(request.auth.uid)).data.lastGiftRoomId
                == roomId
            && getAfter(userPath(request.auth.uid)).data.lastGiftEventId
                == giftId;

        allow update, delete: if false;
      }

      match /task_completions/{taskId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.periodKey is string
            && validRoomTask(request.resource.data)
            && request.resource.data.completedAt == request.time
            && getAfter(roomPath(roomId)).data.lastTaskCompletionId
                == taskId;

        allow update, delete: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isRoomMember(roomId);

        allow create: if isHost(roomId)
            || (
              isRoomMember(roomId)
              && request.resource.data.level
                  == getAfter(roomPath(roomId)).data.roomLevel
              && request.resource.data.unlockedBy == request.auth.uid
              && request.resource.data.sourceTaskId
                  == getAfter(roomPath(roomId)).data.lastTaskCompletionId
              && (
                (
                  request.resource.data.level == 5
                  && request.resource.data.type == 'background_month'
                )
                ||
                (
                  request.resource.data.level != 5
                  && request.resource.data.type == 'gift_pack'
                )
              )
            );

        allow update: if isHost(roomId);
        allow delete: if false;
      }

      match /speaker_stats/{userId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.seconds == 30;

        allow update: if isRoomMember(roomId)
            && userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly(['displayName', 'seconds', 'updatedAt'])
            && request.resource.data.seconds == resource.data.seconds + 30;

        allow delete: if false;
      }

      match /ratings/{ratingId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isRoomMember(roomId)
            && request.resource.data.fromUserId == request.auth.uid
            && request.resource.data.stars is int
            && request.resource.data.stars >= 1
            && request.resource.data.stars <= 5;
        allow delete: if false;
      }

      match /mod_log/{logId} {
        allow read: if isHost(roomId) || isModerator(roomId);
        allow create: if isHost(roomId) || isModerator(roomId);
        allow update, delete: if false;
      }

      match /participants/{userId} {
        allow read: if signedIn();

        // Users create only their own participant record.
        // A normal entrant starts as listener.
        // Host is valid only when the same atomic write establishes
        // that authenticated user as the room host.
        allow create: if signedIn()
            && userId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.handRaised == false
            && request.resource.data.isModerator == false
            && request.resource.data.warningCount == 0
            && request.resource.data.forcedMuted == false
            && request.resource.data.kicked == false
            && (
              (
                request.resource.data.role == 'listener'
                && !('seatIndex' in request.resource.data)
                && (
                  get(roomPath(roomId)).data.isPrivate != true
                  || exists(accessGrantPath(roomId, userId))
                )
              )
              ||
              (
                request.resource.data.role == 'host'
                && request.resource.data.seatIndex == 1
                && isHostAfter(roomId)
              )
            );

        // A listener/member may only update transient state on their own doc.
        // They cannot promote themselves or choose a stage seat.
        allow update: if signedIn()
            && (
              (
                userId == request.auth.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly(['handRaised', 'requestedSeatIndex', 'agoraUid', 'updatedAt'])
                && (
                  !('requestedSeatIndex' in request.resource.data)
                  ||
                  (
                    request.resource.data.requestedSeatIndex is int
                    && request.resource.data.requestedSeatIndex >= 1
                    && request.resource.data.requestedSeatIndex <= 8
                  )
                )
              )
              ||
              (
                userId == request.auth.uid
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 'listener'
                && !('seatIndex' in request.resource.data)
                && request.resource.data.handRaised == false
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'displayName',
                      'photoUrl',
                      'role',
                      'handRaised',
                      'seatIndex',
                      'requestedSeatIndex',
                      'agoraUid',
                      'isModerator',
                      'warningCount',
                      'forcedMuted',
                      'kicked',
                      'joinedAt',
                      'updatedAt'
                    ])
                && request.resource.data.isModerator == false
                && request.resource.data.warningCount == 0
                && request.resource.data.forcedMuted == false
                && request.resource.data.kicked == false
              )
              ||
              (
                isHost(roomId)
                && userId == request.auth.uid
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 'host'
                && request.resource.data.seatIndex == 1
              )
              ||
              (
                isHost(roomId)
                && request.resource.data.uid == resource.data.uid
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'role',
                      'seatIndex',
                      'handRaised',
                      'requestedSeatIndex',
                      'isModerator',
                      'warningCount',
                      'forcedMuted',
                      'updatedAt'
                    ])
                && (
                  (
                    request.resource.data.role == 'listener'
                    && !('seatIndex' in request.resource.data)
                  )
                  ||
                  (
                    request.resource.data.role in [
                      'speaker',
                      'coHost',
                      'vipSeat'
                    ]
                    && request.resource.data.seatIndex is int
                    && request.resource.data.seatIndex >= 2
                    && request.resource.data.seatIndex <= 8
                  )
                  ||
                  (
                    request.resource.data.role == 'host'
                    && request.resource.data.seatIndex == 1
                    && request.resource.data.isModerator == false
                    && getAfter(roomPath(roomId)).data.hostId == userId
                  )
                )
              )
              ||
              (
                isModerator(roomId)
                && resource.data.role != 'host'
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.isModerator == resource.data.isModerator
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'role',
                      'seatIndex',
                      'handRaised',
                      'requestedSeatIndex',
                      'warningCount',
                      'forcedMuted',
                      'updatedAt'
                    ])
                && (
                  request.resource.data.role == resource.data.role
                  ||
                  (
                    request.resource.data.role == 'listener'
                    && !('seatIndex' in request.resource.data)
                  )
                )
              )
            );

        allow delete: if signedIn()
            && (
              userId == request.auth.uid
              || isHost(roomId)
              || (
                isModerator(roomId)
                && resource.data.role != 'host'
              )
            );
      }
    }

    // Everything not explicitly listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
