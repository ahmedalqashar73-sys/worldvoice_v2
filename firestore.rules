rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function participantPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/participants/$(userId);
    }

    function isHost(roomId) {
      return signedIn()
          && exists(roomPath(roomId))
          && get(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function isHostAfter(roomId) {
      return signedIn()
          && getAfter(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function oldHostStillPresent(roomId) {
      return resource.data.hostId is string
          && exists(participantPath(roomId, resource.data.hostId));
    }

    // -------------------------
    // USERS / PROFILES
    // -------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId;

      // A user manages their own profile.
      // Other signed-in users may only refresh follower/following counters,
      // which is required by the current client-side follow flow.
      allow update: if signedIn()
          && (
            request.auth.uid == userId
            ||
            (
              request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['followersCount', 'followingCount'])
              && request.resource.data.followersCount is int
              && request.resource.data.followingCount is int
              && request.resource.data.followersCount >= 0
              && request.resource.data.followingCount >= 0
            )
          );

      allow delete: if signedIn() && request.auth.uid == userId;

      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }

      match /followers/{followerUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == followerUserId;
      }

      match /profile_visitors/{viewerUserId} {
        allow read: if signedIn() && request.auth.uid == userId;

        // The visitor records only their own visit on the target profile.
        allow create, update: if signedIn()
            && request.auth.uid == viewerUserId;

        allow delete: if signedIn()
            && (
              request.auth.uid == userId
              || request.auth.uid == viewerUserId
            );
      }

      match /visited_profiles/{targetUserId} {
        allow read, create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }
    }

    // -------------------------
    // USERNAME RESERVATIONS
    // -------------------------
    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
    }

    // -------------------------
    // VOICE ROOMS
    // -------------------------
    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.hostId == request.auth.uid
          && request.resource.data.channelId == roomId;

      // Normally only the host updates the room.
      // If the old host participant is gone, a new authenticated host may
      // recover that stale room document without changing the channel id.
      allow update: if signedIn()
          && request.resource.data.channelId == resource.data.channelId
          && (
            (
              request.auth.uid == resource.data.hostId
              && request.resource.data.hostId == resource.data.hostId
            )
            ||
            (
              !oldHostStillPresent(roomId)
              && request.resource.data.hostId == request.auth.uid
            )
          );

      allow delete: if isHost(roomId);

      match /participants/{userId} {
        allow read: if signedIn();

        // Users create only their own participant record.
        // A normal entrant starts as listener.
        // Host is valid only when the same atomic write establishes
        // that authenticated user as the room host.
        allow create: if signedIn()
            && userId == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.handRaised == false
            && (
              (
                request.resource.data.role == 'listener'
                && !('seatIndex' in request.resource.data)
              )
              ||
              (
                request.resource.data.role == 'host'
                && request.resource.data.seatIndex == 1
                && isHostAfter(roomId)
              )
            );

        // A listener/member may only update transient state on their own doc.
        // They cannot promote themselves or choose a stage seat.
        allow update: if signedIn()
            && (
              (
                userId == request.auth.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly(['handRaised', 'requestedSeatIndex', 'agoraUid', 'updatedAt'])
                && (
                  !('requestedSeatIndex' in request.resource.data)
                  ||
                  (
                    request.resource.data.requestedSeatIndex is int
                    && request.resource.data.requestedSeatIndex >= 1
                    && request.resource.data.requestedSeatIndex <= 8
                  )
                )
              )
              ||
              (
                userId == request.auth.uid
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 'listener'
                && !('seatIndex' in request.resource.data)
                && request.resource.data.handRaised == false
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'displayName',
                      'photoUrl',
                      'role',
                      'handRaised',
                      'seatIndex',
                      'requestedSeatIndex',
                      'agoraUid',
                      'joinedAt',
                      'updatedAt'
                    ])
              )
              ||
              (
                isHost(roomId)
                && userId == request.auth.uid
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 'host'
                && request.resource.data.seatIndex == 1
              )
              ||
              (
                isHost(roomId)
                && request.resource.data.uid == resource.data.uid
                && request.resource.data
                    .diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'role',
                      'seatIndex',
                      'handRaised',
                      'requestedSeatIndex',
                      'updatedAt'
                    ])
                && (
                  (
                    request.resource.data.role == 'listener'
                    && !('seatIndex' in request.resource.data)
                  )
                  ||
                  (
                    request.resource.data.role in [
                      'speaker',
                      'coHost',
                      'vipSeat'
                    ]
                    && request.resource.data.seatIndex is int
                    && request.resource.data.seatIndex >= 2
                    && request.resource.data.seatIndex <= 8
                  )
                )
              )
            );

        allow delete: if signedIn()
            && (
              userId == request.auth.uid
              || isHost(roomId)
            );
      }
    }

    // Everything not explicitly listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
