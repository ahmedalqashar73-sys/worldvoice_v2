rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function participantPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/participants/$(userId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function globalModeratorPath(ownerId, userId) {
      return /databases/$(database)/documents/users/$(ownerId)/moderators/$(userId);
    }

    function isGlobalModerator(ownerId, userId) {
      return signedIn()
          && ownerId is string
          && ownerId.size() > 0
          && exists(globalModeratorPath(ownerId, userId));
    }

    function isTrustedRoomModerator(roomId, userId) {
      let hostId = getAfter(roomPath(roomId)).data.hostId;
      return isGlobalModerator(hostId, userId);
    }

    function backgroundEntitlementPath(userId, themeId) {
      return /databases/$(database)/documents/users/$(userId)/room_backgrounds/$(themeId);
    }

    function validRoomThemeChange() {
      let oldTheme = resource.data.get('themeId', 'royalPurple');
      let newTheme = request.resource.data.get('themeId', 'royalPurple');
      let oldUrl = resource.data.get('backgroundUrl', '');
      let newUrl = request.resource.data.get('backgroundUrl', '');

      return (
        oldTheme == newTheme && oldUrl == newUrl
      ) || (
        newTheme in ['royalPurple', 'emerald', 'midnight', 'skyBlue', 'forestGold']
        && newUrl == ''
      ) || (
        exists(backgroundEntitlementPath(request.auth.uid, newTheme))
        && get(
          backgroundEntitlementPath(request.auth.uid, newTheme)
        ).data.themeId == newTheme
        && newUrl == get(
          backgroundEntitlementPath(request.auth.uid, newTheme)
        ).data.get('backgroundUrl', '')
        && (
          !('expiresAt' in get(
            backgroundEntitlementPath(request.auth.uid, newTheme)
          ).data)
          || get(
            backgroundEntitlementPath(request.auth.uid, newTheme)
          ).data.expiresAt > request.time
        )
      );
    }

    // A device may run non-monetary legacy/practice quizzes. Verified quiz
    // rounds have a private server answer and cannot be edited or revealed
    // by a client while they are open. Admin SDK bypasses client rules.
    function validClientQuizChange() {
      let previous = resource.data.get('quiz', {});
      let requested = request.resource.data.get('quiz', {});
      return previous == requested || (
        previous.get('roundId', '') == ''
        && requested.get('roundId', '') == ''
        && requested.get('firstPrizeCoins', 0) == 0
        && !('rewardedAt' in requested)
      );
    }

    // Economic state is backend-authoritative. No Firestore client-side gift
    // transaction is allowed, even if a client presents a catalog price.
    function economyFieldsUntouched() {
      return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'coins', 'diamonds', 'diamondsPending', 'diamondsOnHold',
            'giftSentPoints', 'giftReceivedPoints',
            'giftLevelPoints', 'giftLevel',
            'purchasedCoins', 'quizCoinsEarned',
            'lastGiftRoomId', 'lastGiftEventId',
            'walletBalance', 'withdrawableDiamonds', 'walletDebtCoins',
            'walletFrozen', 'payoutFrozen', 'diamondsReserved',
            'firstRechargeUsed', 'payoutFreezeReason', 'identityVerified',
            'isVip', 'isAdmin', 'vipExpiresAt', 'vipSource', 'adminSource',
            'vipUpdatedAt', 'adminUpdatedAt'
          ]);
    }

    function noInitialClientEconomyCredit() {
      return request.resource.data.get('coins', 0) == 0
          && request.resource.data.get('diamonds', 0) == 0
          && request.resource.data.get('diamondsPending', 0) == 0
          && request.resource.data.get('diamondsOnHold', 0) == 0
          && request.resource.data.get('giftLevel', 0) == 0
          && request.resource.data.get('giftLevelPoints', 0) == 0
          && request.resource.data.get('purchasedCoins', 0) == 0
          && request.resource.data.get('giftReceivedPoints', 0) == 0
          && request.resource.data.get('giftSentPoints', 0) == 0
          && request.resource.data.get('isVip', false) == false
          && !request.resource.data.keys().hasAny([
            'lastGiftRoomId', 'lastGiftEventId', 'withdrawableDiamonds',
            'walletBalance', 'vipExpiresAt', 'isAdmin',
            'vipSource', 'adminSource', 'vipUpdatedAt', 'adminUpdatedAt'
          ]);
    }

    function accessGrantPath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/access_grants/$(userId);
    }

    function stageInvitePath(roomId, userId) {
      return /databases/$(database)/documents/rooms/$(roomId)/stage_invites/$(userId);
    }

    function privateCodePath(code) {
      return /databases/$(database)/documents/private_room_codes/$(code);
    }

    function isHost(roomId) {
      return signedIn()
          && exists(roomPath(roomId))
          && get(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function isHostAfter(roomId) {
      return signedIn()
          && getAfter(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function oldHostStillPresent(roomId) {
      return resource.data.hostId is string
          && exists(participantPath(roomId, resource.data.hostId));
    }

    function isRoomMember(roomId) {
      return signedIn()
          && exists(participantPath(roomId, request.auth.uid));
    }

    // TEST-only preview events have no fields for economy, rewards or XP.
    function validFreeGiftPreview(senderId) {
      return signedIn()
          && senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'nonce', 'senderId', 'senderName', 'recipientId',
            'recipientName', 'giftId', 'sentAt'
          ])
          && request.resource.data.keys().hasAll([
            'nonce', 'senderId', 'senderName', 'recipientId',
            'recipientName', 'giftId', 'sentAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.nonce is string
          && request.resource.data.nonce.matches('^[0-9a-f]{24}$')
          && request.resource.data.giftId is string
          && request.resource.data.giftId.matches('^(classic|luxury)_[a-z_]{1,60}$')
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.recipientId != 'teacher_ai'
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.recipientName is string
          && request.resource.data.recipientName.size() > 0
          && request.resource.data.recipientName.size() <= 100
          && request.resource.data.sentAt == request.time;
    }

    function isModerator(roomId) {
      return isRoomMember(roomId)
          && get(participantPath(roomId, request.auth.uid)).data.isModerator == true;
    }

    // -------------------------
    // USERS / PROFILES
    // -------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && noInitialClientEconomyCredit()
          && !request.resource.data.keys().hasAny([
            'walletDebtCoins', 'walletFrozen', 'payoutFrozen',
            'diamondsReserved', 'firstRechargeUsed', 'payoutFreezeReason',
            'identityVerified'
          ]);

      // Preserve existing non-financial profile/follow operations only.
      allow update: if signedIn()
          && (
            (request.auth.uid == userId && economyFieldsUntouched())
            ||
            (
              request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['followersCount', 'followingCount'])
              && request.resource.data.followersCount is int
              && request.resource.data.followingCount is int
              && request.resource.data.followersCount >= 0
              && request.resource.data.followingCount >= 0
            )
          );

      // Account deletion must be processed server-side to preserve the ledger.
      allow delete: if false;

      match /moderators/{moderatorUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
            && request.auth.uid == userId
            && moderatorUserId != userId
            && request.resource.data.uid == moderatorUserId
            && request.resource.data.assignedBy == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == userId;
      }

      match /followers/{followerUserId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
            && request.auth.uid == followerUserId;
      }

      match /profile_visitors/{viewerUserId} {
        allow read: if signedIn() && request.auth.uid == userId;

        // The visitor records only their own visit on the target profile.
        allow create, update: if signedIn()
            && request.auth.uid == viewerUserId;

        allow delete: if signedIn()
            && (
              request.auth.uid == userId
              || request.auth.uid == viewerUserId
            );
      }

      match /visited_profiles/{targetUserId} {
        allow read, create, update, delete: if signedIn()
            && request.auth.uid == userId;