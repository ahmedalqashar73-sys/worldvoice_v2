FIREBASE_PROJECT_ID=worldvoice-37896
# Hosted providers such as Render can use one JSON environment secret instead
# of a local credentials file. Keep the real JSON only in the provider's
# secret/environment settings; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Do not commit real secret values.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Free-tier Teacher AI service: keep real credentials ONLY in Render.
GROQ_API_KEY=
GROQ_TEACHER_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional legacy provider if GROQ_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_TEACHER_MODEL=
PORT=8080

ANDROID_PACKAGE_NAME=com.worldvoice.app
IOS_BUNDLE_ID=com.worldvoice.worldvoice

# App Store Connect In-App Purchase server credentials.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Keep the private key on the server only. Escaped \n is supported.
APPLE_IAP_PRIVATE_KEY=

# Firebase/Google Application Default Credentials used by Cloud Run also need
# Google Play Android Publisher API access to verify Android purchases.
