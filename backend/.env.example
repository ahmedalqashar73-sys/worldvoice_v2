# Do not commit real secret values.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
OPENAI_API_KEY=
OPENAI_TEACHER_MODEL=
PORT=8080

# Must match FirebaseOptions.projectId in Flutter (not a secret).
FIREBASE_PROJECT_ID=worldvoice-37896
# Local development: absolute path to a matching Firebase service account
# JSON kept outside this repository. Cloud Run normally uses its attached
# service account and does not need a JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/worldvoice-service-account.json

ANDROID_PACKAGE_NAME=com.worldvoice.worldvoice
IOS_BUNDLE_ID=com.worldvoice.worldvoice

# App Store Connect In-App Purchase server credentials.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Keep the private key on the server only. Escaped \n is supported.
APPLE_IAP_PRIVATE_KEY=

# Firebase/Google Application Default Credentials used by Cloud Run also need
# Google Play Android Publisher API access to verify Android purchases.
