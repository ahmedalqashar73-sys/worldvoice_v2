  "dialogue": [
    {
      "speaker": "Jonathan",
      "text": "Hey, Pete! Who’s your friend?",
      "translation_ar": "مرحبًا يا بيت! من صديقتك؟",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Pete",
      "text": "She is Anna. She is new to D.C.",
      "translation_ar": "هذه آنا. إنها جديدة في واشنطن.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "Where are you from?",
      "translation_ar": "من أين أنت؟",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "I am from a small town.",
      "translation_ar": "أنا من بلدة صغيرة.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "Well, welcome to D.C.",
      "translation_ar": "حسنًا، أهلًا بك في واشنطن.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Thank you.",
      "translation_ar": "شكرًا لك.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "I am Jonathan. I am in apartment B4.",
      "translation_ar": "أنا جوناثان. أسكن في الشقة B4.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "I am in apartment C2. Marsha is my roommate.",
      "translation_ar": "أنا في الشقة C2. مارشا زميلتي في السكن.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "I know Marsha. She is nice.",
      "translation_ar": "أعرف مارشا. إنها لطيفة.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Pete",
      "text": "And I am in Apartment D7. I have to go now.",
      "translation_ar": "وأنا أسكن في الشقة D7. عليّ الذهاب الآن.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Oh!",
      "translation_ar": "أوه!",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Pete",
      "text": "Remember to call Marsha at work. Tell her you’re here.",
      "translation_ar": "تذكري أن تتصلي بمارشا في العمل، وأخبريها أنك وصلت.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Right, thanks, Pete. Nice to meet you!",
      "translation_ar": "صحيح، شكرًا يا بيت. تشرفت بلقائك!",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "You too, Bye.",
      "translation_ar": "وأنا كذلك، وداعًا.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Apartment C2, here I come!",
      "translation_ar": "الشقة C2، أنا قادمة!",
      "start_ms": null,
      "end_ms": null
    }
  ],
