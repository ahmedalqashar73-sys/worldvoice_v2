  "dialogue": [
    {
      "speaker": "Anna",
      "text": "Hello, everyone. Here I am at my new job! Yesterday at my first day of work … Well, let’s not talk about yesterday. Today is a new day! Today I want to apologize to my co-workers.",
      "translation_ar": "مرحبًا بالجميع. ها أنا في عملي الجديد! بالأمس كان يومي الأول... حسنًا، لندع الأمس. اليوم يوم جديد، وأريد الاعتذار لزملائي.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Hi, Anne. Are you busy?",
      "translation_ar": "مرحبًا يا آن، هل أنت مشغولة؟",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anne",
      "text": "Hi, Anna. Yes. At 10 a.m. I am writing. Every day I do my morning show. Sorry!",
      "translation_ar": "مرحبًا يا آنا. نعم. في العاشرة صباحًا أكتب. أقدم برنامجي الصباحي كل يوم. آسفة!",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Okay. See you later, maybe.",
      "translation_ar": "حسنًا، ربما أراك لاحقًا.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anne",
      "text": "Maybe I’ll see you later.",
      "translation_ar": "ربما أراك لاحقًا.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Hi, Jonathan. Are you busy?",
      "translation_ar": "مرحبًا يا جوناثان، هل أنت مشغول؟",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "Yes, I’m busy. When the studio light is on, I am recording my evening show.",
      "translation_ar": "نعم، أنا مشغول. عندما يضيء مصباح الاستوديو أسجل برنامجي المسائي.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Right. Sorry about yesterday.",
      "translation_ar": "صحيح. أنا آسفة على ما حدث أمس.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "No worries.",
      "translation_ar": "لا تقلقي.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "May I see the studio?",
      "translation_ar": "هل يمكنني رؤية الاستوديو؟",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Jonathan",
      "text": "Um, maybe another time? Right now I am busy.",
      "translation_ar": "أمم، ربما في وقت آخر؟ أنا مشغول الآن.",
      "start_ms": null,
      "end_ms": null
    },
    {
      "speaker": "Anna",
      "text": "Sure. Okay, ’bye.",
